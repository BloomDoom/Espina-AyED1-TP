"""
Escribir un programa que permita ingresar un número entero N y genere un
diccionario por comprensión con la tabla de multiplicar de N del 1 al 12. Mostrar la
tabla de multiplicar con el formato apropiado.
"""

def main() -> None:
    """Programa principal."""
    while True:
        try:
            n = int(input('Ingrese un número entero: '))
            break
        except ValueError:
            print('Intente nuevamente con un número.')

    diccionario = {m:n*m for m in range(1, 13)}
    print("Escribir un programa que permita ingresar un número entero N y " \
    "genere un diccionario por comprensión con la tabla de multiplicar de N " \
    "del 1 al 12. Mostrar la tabla de multiplicar con el formato apropiado.")
    print()
    print("Diccionario:")
    print(diccionario)


if __name__ == '__main__':
    main()