"""
Generar e imprimir un diccionario donde las claves sean números enteros entre 1 y
20 (ambos incluidos) y los valores asociados sean el cuadrado de las claves.
"""

def main() -> None:
    """Programa principal."""
    print('Generar e imprimir un diccionario donde las claves sean números ' \
    'enteros entre 1 y 20 (ambos incluidos) y los valores asociados sean el ' \
    'cuadrado de las claves.')
    dicionario = {n:n*n for n in range(1, 21)}
    print()
    print('Diccionario:')
    print(dicionario)


if __name__ == '__main__':
    main()